[Unit]
Description=Pull approved Flight Display %i release
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/where-do-you-fly/deploy/pull.py /etc/where-do-you-fly/%i.json
UMask=0077
TimeoutStartSec=20min
