[Unit]
Description=Pull approved Flight Display %i release
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/where-do-you-fly/%i.compose.env
ExecStart=/usr/bin/docker compose --project-name flight-%i --env-file /etc/where-do-you-fly/%i.compose.env -f /opt/where-do-you-fly/deploy/compose.yaml up -d --pull always --wait --wait-timeout 90
UMask=0077
TimeoutStartSec=20min
